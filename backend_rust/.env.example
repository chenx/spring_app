# Copy to .env (or export directly) before running the server.
# Replace this placeholder with your own strong 32+ character key.
# Never commit the real value or upload it to source control.
JWT_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# Optional overrides -- defaults below match application.yml (the dev profile).
# See .env.prod.example for values mirroring application-prod.yml.
#PORT=8080
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
#CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
#CORS_ALLOWED_HEADERS=*
#CORS_MAX_AGE=3600
