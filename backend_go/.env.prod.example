# Mirrors src/main/resources/application-prod.yml from backend_java.
# Copy to .env.prod (or export these directly) for a production deployment.

# Cloud providers commonly inject PORT; falls back to 8080 if unset.
PORT=8080

# Replace with your actual live frontend domain(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_MAX_AGE=3600

# Required. Never commit the real value or share it.
# Generate one with: openssl rand -base64 48
JWT_SECRET_KEY=
